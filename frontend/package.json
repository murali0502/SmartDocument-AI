{
  "name": "smartdoc-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --strictPort",
    "contracts": "openapi-typescript ../.local/openapi.json -o src/generated/api.ts",
    "test:e2e": "playwright test"
  },
  "engines": { "node": "^22.12.0 || >=24.0.0" },
  "dependencies": { "react": "^19.2.0", "react-dom": "^19.2.0" },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "openapi-typescript": "^7.10.0",
    "swagger-ui-dist": "5.36.0",
    "typescript": "~5.9.0",
    "vite": "^7.3.0"
  }
}
